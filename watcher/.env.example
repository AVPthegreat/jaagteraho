# JaagteRaho watcher settings. Copy to .env and fill in. Never commit .env.

# Claude (Anthropic API). Named JR_ on purpose: Claude Code would use a shell
# variable called ANTHROPIC_API_KEY and spend this credit.
JR_ANTHROPIC_API_KEY=

# Models
JR_DECISION_MODEL=claude-haiku-5-5
JR_DIAGNOSIS_MODEL=claude-sonnet-5-5

# Spend guard, in US dollars
JR_SPEND_HAIKU_ONLY_AT=40
JR_SPEND_STOP_AT=45

# Telegram bot token from @BotFather (the JaagteRaho bot)
JR_TELEGRAM_BOT_TOKEN=

# Wake-up voice: "gnani" (leave empty to switch voice off)
JR_VOICE_PROVIDER=
JR_GNANI_API_KEY=
# hi (Hindi, default) or en; Gnani Timbre voice name, e.g. Nalini (Hindi) or Kaveri (English)
JR_VOICE_LANG=hi
JR_GNANI_VOICE=Nalini

# GitHub tokens, each as narrow as possible:
#   sandbox: fine-grained, the demo repository only, Contents + Pull requests: write
#   faurus:  fine-grained, faurus-app only, Contents: read-only
#   public:  fine-grained, no repository access at all (raises the public read limit
#            from 60 to 5,000 requests an hour for the paste-your-error page)
JR_GITHUB_SANDBOX_TOKEN=
JR_GITHUB_FAURUS_READ_TOKEN=
JR_GITHUB_PUBLIC_READ_TOKEN=
# Self-healing a real app (optional): a write token for that one repository, per app id, e.g. JR_GITHUB_HEAL_TOKEN_123456=
# (contents + pull requests: write). Without it, heals arrive as a ready-to-apply diff. See src/pipeline/heal.ts.

# Public address of this watcher (used in DSNs and signed owner links), e.g. https://api.example.com
JR_PUBLIC_INTAKE_URL=
# Website origins allowed to call the public API, comma-separated, e.g. https://jaagteraho.vercel.app
JR_SITE_ORIGINS=http://localhost:3000

# Secret used to sign owner-page links (any long random string)
JR_LINK_SECRET=

# Free AI credit per Telegram account, in US dollars (diagnoses and fixes; deciding and alerting are free)
JR_FREE_CREDIT_USD=5

# Read-only GitHub App for private repositories (optional; see deploy/README.md "GitHub app").
# Permissions: Contents read, Metadata read. Turn on "Request user authorization (OAuth) during installation"
# and set the Setup URL to <JR_PUBLIC_INTAKE_URL>/github/setup.
JR_GITHUB_APP_ID=
JR_GITHUB_APP_SLUG=
JR_GITHUB_APP_CLIENT_ID=
JR_GITHUB_APP_CLIENT_SECRET=
# The app's private key: a path to the .pem file, or the key itself with \n for line breaks
JR_GITHUB_APP_PRIVATE_KEY_FILE=
JR_GITHUB_APP_PRIVATE_KEY=

# Log drains: some hosts ask the drain address to answer with a verification header
JR_VERCEL_VERIFY=

# Python used to prove demo-portal fixes with the model's regression test (needs Django for one fault)
JR_TEST_PYTHON=python3
# Set to 0 to show the diagnosis only the files in the stack trace (used to measure the difference)
JR_RELATED_FILES=1
